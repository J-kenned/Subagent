{
  "name": "subagent-mcp",
  "version": "0.1.0",
  "description": "Dispatch coding agents — claude, codex, cursor, kiro — locally or in the cloud, from any MCP client.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "subagent-mcp": "dist/server.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "plugin",
    "docs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "check": "npm run lint && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
